<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A-69 (M10): the mandate OrgnlEndToEndId. Deterministic from the full spine
         identity (arrival_id, sequence, action_code), minted write-ahead alongside
         out_msg_id/mndt_req_id, carried on the outbound pain.009/.010/.011 and echoed
         on the pain.012 reply so MAR captures a non-NULL e2e. ADDITIVE + nullable:
         existing rows predate the reference; every new write populates it. Guarded
         columnExists/MARK_RAN so a resume against a migrated DB is a re-run no-op
         (persistence.md: pure-XML typed tags only). -->
    <changeSet id="mrw-003-man-outbound-orgnl-e2e" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="man_outbound" columnName="orgnl_e2e"/></not>
        </preConditions>
        <addColumn tableName="man_outbound">
            <column name="orgnl_e2e" type="VARCHAR(35)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
